    (stmts~2,1
     (asgn@E
      (at~8 result~6
       (infix@2 * i~1 8@1))
      (suf@2 1u "u8"))
     (asgn@E,1
      (at~8 result~6
       (infix@4 \2B
        (infix~2 * i~1 8@1)1@1))
      (suf@2 2u "u8"))
     (asgn@E,2
