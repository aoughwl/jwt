(.nif27)
(.vendor "Nifler")
(.dialect "nim-parsed")
(stmts@,1,src/repro2.nim
 (proc test32@5 . . .
  (params@B)
  (at@9 array~5 32@1 byte@5). .
  (stmts@2,1
   (for@4
    (infix@7 \2E\2E< 0~2 8@4)
    (unpackflat
     (let i . . ..))
    (stmts~2,1
     (asgn@C
      (at~6 result~6
       (infix@2 * i~1 4@1))
      (suf@2 1u "u8"))
     (asgn@E,1
      (at~8 result~6
       (infix@4 \2B
        (infix~2 * i~1 4@1)1@1))
      (suf@2 2u "u8"))
     (asgn@E,2
      (at~8 result~6
       (infix@4 \2B
        (infix~2 * i~1 4@1)2@1))
      (suf@2 3u "u8"))
     (asgn@E,3
      (at~8 result~6
       (infix@4 \2B
        (infix~2 * i~1 4@1)3@1))
      (suf@2 4u "u8")))))))